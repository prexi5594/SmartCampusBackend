# The backend reads process environment variables; it does not load this file automatically.
# Default local URL. Use your HTTPS origin when deploying a shared server.
CAMPUS_ORIGIN=http://127.0.0.1:8765
# python -m backend uses this origin's host/port locally for both frontend and API.
# If PORT is also set locally, it must match the origin's port.
# Optional absolute private storage directory, outside prototype/. Back up BOTH stores.
# CAMPUS_DATA_DIR=C:/campus-private-data
# Session lifetime, in seconds (default: 7 days).
CAMPUS_SESSION_SECONDS=604800
# Containers require production mode, a public HTTPS origin and persistent data.
# Railway can obtain the origin from its generated RAILWAY_PUBLIC_DOMAIN.
# Attach a persistent volume at /data before deploying.
# CAMPUS_ENV=production
# CAMPUS_DATA_DIR=/data/campus
